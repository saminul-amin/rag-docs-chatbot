# --- LLM provider (pick one) ---------------------------------------------
# OpenRouter: one key for both chat and embeddings. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# ...or OpenAI directly:
# OPENAI_API_KEY=

# Optional model overrides (defaults shown for OpenRouter)
# CHAT_MODEL=google/gemini-2.5-flash-lite
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# --- Database ------------------------------------------------------------
# Any Postgres with the pgvector extension (Neon, Supabase, RDS, Docker...).
# Leave empty to use an embedded PGlite database in ./.data (local dev only).
DATABASE_URL=

# --- Demo guardrails (optional) -----------------------------------------
# CHAT_PER_IP_PER_HOUR=40
# CHATS_PER_DAY_GLOBAL=2000
# UPLOADS_PER_IP_PER_HOUR=10
# MAX_FILE_MB=4
# MAX_DOCS_PER_WORKSPACE=5
# UPLOAD_RETENTION_HOURS=24
